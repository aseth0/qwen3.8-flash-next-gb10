# Copy to .env and fill in. .env is NOT versioned.
# Endpoint key (generate one: echo "sk-fn-$(head -c12 /dev/urandom | base64 | tr -dc A-Za-z0-9)")
API_KEY=
# Host directory for the weights. A dedicated one, NOT inside a HF cache (different layout).
# (needs ~210 GB free: 102 for the original + 96 for the BF16 PLE)
MODELS_DIR=/opt/models-vllm
# vLLM cache (graphs, model info). Created automatically.
CACHE_DIR=./cache
PORT=8010
